generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms     Room[]
  chats     Chat[]
  joinedRooms UserRoomMapping[]
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  description String?
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  chats     Chat[]
  shapes    Shape[]
  members   UserRoomMapping[]
}

model UserRoomMapping {
  userId String
  roomId Int
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

model Chat {
  id        Int      @id @default(autoincrement())
  userId    String
  roomId    Int
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shape {
  id        Int      @id @default(autoincrement())
  roomId    Int
  type      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}